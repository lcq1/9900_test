# Configuration template only; this file is not loaded automatically.
# Copy to .env and replace placeholders before starting Docker Compose.
# Host/local backend connection. Compose supplies the internal db hostname.
DATABASE_URL=postgresql+psycopg://app_user:replace-with-your-database-password@127.0.0.1:5432/app_database
# Optional remote PostgreSQL override for the backend container:
# DOCKER_DATABASE_URL=postgresql+psycopg://app_user:replace-with-your-database-password@db.example.com:5432/app_database
# Set TEST_DATABASE_URL in the shell when running pytest (separate database):
# TEST_DATABASE_URL=postgresql+psycopg://test_user:replace-with-your-test-password@127.0.0.1:5432/app_database_test
JWT_SECRET=replace-with-a-random-secret
CORS_ORIGINS=http://localhost:5173
# Permanent provider: an OpenAI-compatible Chat Completions endpoint.
AI_PROVIDER=openai_compatible
AI_API_KEY=
AI_API_BASE=https://api.example.com/v1/chat/completions
AI_MODEL=replace-with-your-model
# All AI configuration is server-side. Disable streaming for JSON-only providers.
AI_STREAM=true
AI_TIMEOUT_SECONDS=60
# Optional; omit to use the provider's default temperature.
# AI_TEMPERATURE=0.7
# Optional; omit to use Beyond's default research assistant instructions.
# AI_SYSTEM_PROMPT="Your server-owned assistant instructions"
AI_MAX_PROMPT_CHARS=4000
AI_HISTORY_MESSAGES=8
AI_HISTORY_MESSAGE_CHARS=2000
# Transitional WorkBuddy configuration (replace the four AI_* values above):
# AI_PROVIDER=workbuddy
# AI_API_KEY=replace-with-your-workbuddy-app-key
# AI_API_BASE=https://your-app.workbuddy.host/.cloud/llm/chat/completions
# AI_MODEL=replace-with-your-workbuddy-model
# For WorkBuddy, AI_API_KEY holds its PUBLIC app key, not a provider secret.
# AI_API_BASE must be the full completion URL for either provider.
POSTGRES_USER=app_user
POSTGRES_PASSWORD=replace-with-your-database-password
POSTGRES_DB=app_database
# POSTGRES_* initialize a NEW volume only. Existing volumes retain their old roles/passwords/databases.
# To reuse data after renaming the Compose project, explicitly select its existing volumes:
# POSTGRES_VOLUME_NAME=your-original-project_postgres_data
# BACKEND_STORAGE_VOLUME_NAME=your-original-project_backend_storage
# BACKEND_LOGS_VOLUME_NAME=your-original-project_backend_logs
POSTGRES_PORT=5432
FRONTEND_PORT=5173
BACKEND_PORT=8000
