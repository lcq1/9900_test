# Copy this file to .env for local development. Never place real secrets here.
APP_ENV=development
APP_SECRET_KEY=replace-with-a-long-random-value

# PostgreSQL connection used only by the backend.
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/experiment_platform

# Session cookies should be Secure in deployed HTTPS environments.
SESSION_COOKIE_NAME=experiment_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=86400

# Administrator credentials must be stored as a password hash, never plaintext.
ADMIN_PASSWORD_HASH=replace-with-an-argon2id-hash

# Optional S3-compatible object storage configuration.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional external AI provider configuration; this key is backend-only.
AI_API_BASE_URL=
AI_API_KEY=
