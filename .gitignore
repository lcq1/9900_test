# Frontend dependencies and build outputs.
frontend/node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo
/package-lock.json

# Python caches, virtual environments and test outputs.
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# Local secrets must never be committed; the example file remains tracked.
.env
.env.*
!.env.example

# IDE and operating-system generated files.
.idea/
.vscode/
.DS_Store
Thumbs.db

# Runtime logs and temporary files.
*.log
tmp/
