# Copy to repository-root .env.production. Never commit actual credentials.
# A DNS name pointing to the server enables automatic HTTPS through Caddy.
SITE_ADDRESS=beyond.example.org
PUBLIC_ORIGIN=https://beyond.example.org
PUBLIC_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
# Choose a distinct project name per independent installation.
COMPOSE_PROJECT_NAME=beyond-production
POSTGRES_USER=beyond
POSTGRES_DB=beyond
# Replace both values before use. Hexadecimal secrets avoid DB URL escaping.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
JWT_SECRET=replace-with-an-independent-long-random-signing-secret
# Match this to the env file used by --env-file if renaming it.
BEYOND_ENV_FILE=.env.production
# Optional: override the backend connection for a managed PostgreSQL service.
# DOCKER_DATABASE_URL=postgresql+psycopg://user:URL_ENCODED_PASSWORD@host:5432/database
LOCAL_STORAGE_DIR=/app/storage
STORAGE_LOCATIONS={}
STORAGE_DEFAULT_LOCATION=legacy
# Optional: retain explicit existing volume names on the SAME Docker host.
# POSTGRES_VOLUME_NAME=existing_postgres_data
# BACKEND_STORAGE_VOLUME_NAME=existing_backend_storage
# BACKEND_LOGS_VOLUME_NAME=existing_backend_logs
# New installations can register the first account and bootstrap it as admin.
# This email restriction also applies to existing researchers and admins.
ACCESS_ALLOWLIST_ENABLED=true
ALLOWED_EMAILS=k.alqattan@unsw.edu.au
ALLOWED_DOMAINS=
# Alternatively configure AI in the researcher's Workspace settings.
AI_PROVIDER=openai_compatible
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
AI_STREAM=true
AI_TIMEOUT_SECONDS=60
